{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Disposable synthetic standard RDS benchmark; TLS and operator /32 ingress; no real data.",
  "Parameters": {
    "RunId": {
      "Type": "String",
      "AllowedPattern": "rds-upgrade-[a-f0-9]{12}"
    },
    "SourceVersion": {
      "Type": "String",
      "Default": "16.15",
      "AllowedPattern": "16\\.[0-9]+"
    },
    "InstanceClass": {
      "Type": "String",
      "Default": "db.r7g.xlarge",
      "AllowedValues": [
        "db.r7g.xlarge",
        "db.r7g.large"
      ]
    },
    "ClientCidr": {
      "Type": "String",
      "AllowedPattern": "[0-9]{1,3}(\\.[0-9]{1,3}){3}/32"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.84.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "Synthetic RDS benchmark: one operator IPv4 address only",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": {
              "Ref": "ClientCidr"
            }
          }
        ]
      }
    },
    "SubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Disposable RDS upgrade benchmark",
        "SubnetIds": [
          {
            "Ref": "Subnet0"
          },
          {
            "Ref": "Subnet1"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "DependsOn": "InternetRoute",
      "Properties": {
        "DBInstanceIdentifier": {
          "Ref": "RunId"
        },
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "SourceVersion"
        },
        "DBInstanceClass": {
          "Ref": "InstanceClass"
        },
        "AllocatedStorage": "400",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "benchmark",
        "MasterUsername": "labadmin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "SubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "PubliclyAccessible": true,
        "MultiAZ": false,
        "BackupRetentionPeriod": 1,
        "DeleteAutomatedBackups": true,
        "AutoMinorVersionUpgrade": false,
        "DeletionProtection": false,
        "CopyTagsToSnapshot": true,
        "Tags": [
          {
            "Key": "RdsBenchmarkRun",
            "Value": {
              "Ref": "RunId"
            }
          }
        ]
      }
    },
    "Subnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "RouteAssociation0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet0"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "Subnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "RouteAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet1"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    }
  },
  "Outputs": {
    "DatabaseId": {
      "Value": {
        "Ref": "Database"
      }
    }
  }
}
